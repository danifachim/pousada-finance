# ---------- Pluggy (https://dashboard.pluggy.ai) ----------
# Cadastre uma aplicação no painel do Pluggy e copie o Client ID e o Client Secret.
# NUNCA coloque estes valores em variáveis NEXT_PUBLIC_* nem no código.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Segredo que protege a URL do webhook. Gere um valor longo e aleatório, por exemplo:
#   openssl rand -hex 32
PLUGGY_WEBHOOK_SECRET=

# Mostra os bancos de teste ("Pluggy Bank") no widget. Use "true" só para testar; remova em produção.
NEXT_PUBLIC_PLUGGY_INCLUDE_SANDBOX=false

# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (ou "anon" em projetos antigos). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave "secret" (ou "service_role" em projetos antigos). SOMENTE no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
# URL pública do sistema (usada para o Pluggy avisar de novas transações via webhook).
# Em produção: https://seu-sistema.vercel.app  (o webhook exige HTTPS público).
# Em desenvolvimento local o webhook não funciona; use o botão "Atualizar" no sistema.
NEXT_PUBLIC_APP_URL=http://localhost:3000
